<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AStar.Dev.Utilities
    ═══════════════════
    Extension methods, helpers, and shared primitives consumed across all
    AStar Development packages and applications.

    TFM, nullable, implicit usings, TreatWarningsAsErrors, IsPackable, IncludeSymbols,
    SymbolPackageFormat, and output paths are all inherited from the repo-root
    Directory.Build.props. Only package-specific metadata lives here.
  -->

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageTags>utilities;extensions;helpers;astar;astardevelopment</PackageTags>
    <Title>AStar Dev Utilities</Title>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Description>A collection of useful utilities that do not fit within any of the other, more targeted, AStar Dev NuGet packages.</Description>
    <PackageProjectUrl>https://github.com/astar-development/astar-dev-mono/tree/main/packages/core</PackageProjectUrl>
    <DocumentationFile>$(AssemblyName).xml</DocumentationFile>
    <PackageReleaseNotes>No functional changes. Just a new 'home' on GitHub.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Add <PackageReference Include="..." /> entries here as needed.
      Example — if you depend on Microsoft.Extensions.Logging.Abstractions:
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    -->
  </ItemGroup>

</Project>
