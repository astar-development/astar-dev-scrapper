<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AStar.Dev.Wallpaper.Scrapper.MainWindow"
        Title="AStar Wallpaper Scrapper"
        Width="800"
        Height="450">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,12,12,0" Spacing="8">
            <Button Content="Edit Configuration" Click="OnEditConfigurationClicked" />
        </StackPanel>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="24"
                   Text="Welcome" />
    </DockPanel>
</Window>
