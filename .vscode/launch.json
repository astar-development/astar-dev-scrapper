{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Wallpaper Scrapper (all scenarios)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "/usr/bin/dotnet",
            "args": [
                "test",
                "--no-build",
                "${workspaceFolder}/AStar.Dev.Wallpaper.Scrapper/AStar.Dev.Wallpaper.Scrapper.csproj"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
